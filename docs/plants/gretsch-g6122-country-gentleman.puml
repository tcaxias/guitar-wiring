@startuml
title Gretsch G6122-1959 Country Gentleman
-- 2x Filter'Tron humbuckers, 3-way toggle, individual volumes, master volume, no tone

rectangle "Neck Filter'Tron" as neck
rectangle "Bridge Filter'Tron" as bridge
rectangle "3-way toggle" as selector
rectangle "Neck volume 500k" as vol_neck
rectangle "Bridge volume 500k" as vol_bridge
rectangle "Master volume 500k" as vol_master
rectangle "Output jack" as jack
rectangle "Ground" as ground

node "A START (neck:a-start)" as neck_hot
node "A END (neck:a-finish)" as neck_ret
node "B END (neck:b-finish)" as neck_bend
node "SHIELD (neck:shield)" as neck_shield

node "A START (bridge:a-start)" as bridge_hot
node "A END (bridge:a-finish)" as bridge_ret
node "B END (bridge:b-finish)" as bridge_bend
node "SHIELD (bridge:shield)" as bridge_shield

node "A1 (selector:a1)" as sel_a1
node "A2 (selector:a2)" as sel_a2
node "A3 (selector:a3)" as sel_a3
node "B1 (selector:b1)" as sel_b1
node "B2 (selector:b2)" as sel_b2
node "B3 (selector:b3)" as sel_b3
node "A-COMMON (selector:a-common)" as sel_acom
node "B-COMMON (selector:b-common)" as sel_bcom

node "INPUT (volume:input)" as v1_in
node "WIPER (volume:wiper)" as v1_wip
node "GROUND (volume:ground)" as v1_gnd
node "CASING (volume:casing)" as v1_case

node "INPUT (volume-2:input)" as v2_in
node "WIPER (volume-2:wiper)" as v2_wip
node "GROUND (volume-2:ground)" as v2_gnd
node "CASING (volume-2:casing)" as v2_case

node "INPUT (master:input)" as vm_in
node "WIPER (master:wiper)" as vm_wip
node "GROUND (master:ground)" as vm_gnd
node "CASING (master:casing)" as vm_case

node "TIP (jack:tip)" as jack_tip
node "SLEEVE (jack:sleeve)" as jack_slv

node "COMMON (ground:common)" as gnd_comm

neck_hot -[red]> neck
neck -[red]> neck_ret
neck_ret -[red]> neck_bend
neck_bend -[gray]> neck
neck_shield -[gray]> neck

bridge_hot -[red]> bridge
bridge -[red]> bridge_ret
bridge_ret -[red]> bridge_bend
bridge_bend -[gray]> bridge
bridge_shield -[gray]> bridge

sel_a1 -[red]> selector
sel_a2 -[red]> selector
sel_a3 -[red]> selector
sel_b1 -[red]> selector
sel_b2 -[red]> selector
sel_b3 -[red]> selector
sel_acom -[red]> selector
sel_bcom -[red]> selector

v1_in -[red]> vol_neck
v1_wip -[red]> vol_neck
v1_gnd -[gray]> vol_neck
v1_case -[gray]> vol_neck

v2_in -[red]> vol_bridge
v2_wip -[red]> vol_bridge
v2_gnd -[gray]> vol_bridge
v2_case -[gray]> vol_bridge

vm_in -[red]> vol_master
vm_wip -[red]> vol_master
vm_gnd -[gray]> vol_master
vm_case -[gray]> vol_master

jack_tip -[red]> jack
jack_slv -[gray]> jack

neck_hot -[red]> v1_in
neck_ret -[red]> neck_bend
neck_bend -[gray]> gnd_comm
neck_shield -[gray]> gnd_comm

bridge_hot -[red]> v2_in
bridge_ret -[red]> bridge_bend
bridge_bend -[gray]> gnd_comm
bridge_shield -[gray]> gnd_comm

sel_acom -[red]> v1_wip
sel_bcom -[red]> v2_wip
sel_a1 -[red]> sel_a2
sel_b3 -[red]> sel_b2
sel_bcom -[red]> sel_acom

v1_wip -[red]> vm_in
v2_wip -[red]> vm_in
vm_wip -[red]> jack_tip

v1_gnd -[gray]> gnd_comm
v1_case -[gray]> gnd_comm
v2_gnd -[gray]> gnd_comm
v2_case -[gray]> gnd_comm
vm_gnd -[gray]> gnd_comm
vm_case -[gray]> gnd_comm

gnd_comm -[gray]> jack_slv

@enduml